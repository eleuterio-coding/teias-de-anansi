rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Hub pessoal e fechado: o Firebase Authentication é a única barreira de entrada.
    // A diferença Mestre/Jogador é funcional e aplicada pelo Hub ao escolher entre
    // a projeção privada e a projeção compartilhada da Mesa.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
