rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function authorizedUserPath(uid) {
      return /databases/$(database)/documents/authorizedUsers/$(uid);
    }

    function isAuthorized() {
      return signedIn()
        && exists(authorizedUserPath(request.auth.uid))
        && get(authorizedUserPath(request.auth.uid)).data.active == true;
    }

    function isAdmin() {
      return isAuthorized()
        && get(authorizedUserPath(request.auth.uid)).data.isAdmin == true;
    }

    function membershipId(campaignId) {
      return campaignId + '_' + request.auth.uid;
    }

    function membershipPath(campaignId) {
      return /databases/$(database)/documents/memberships/$(membershipId(campaignId));
    }

    function isMember(campaignId) {
      return isAuthorized()
        && exists(membershipPath(campaignId))
        && get(membershipPath(campaignId)).data.active == true;
    }

    function isDm(campaignId) {
      return isMember(campaignId)
        && get(membershipPath(campaignId)).data.role == 'dm';
    }

    function campaignPath(campaignId) {
      return /databases/$(database)/documents/campaigns/$(campaignId);
    }

    function isOwner(campaignId) {
      return isAuthorized()
        && exists(campaignPath(campaignId))
        && get(campaignPath(campaignId)).data.ownerId == request.auth.uid;
    }

    function canManage(campaignId) {
      return isAdmin() || isOwner(campaignId) || isDm(campaignId);
    }

    match /authorizedUsers/{uid} {
      allow read: if isAuthorized()
        && (request.auth.uid == uid || isAdmin());

      allow create, update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow read, create, update, delete: if isAuthorized()
        && request.auth.uid == uid;

      match /characters/{characterId} {
        allow read, create, update, delete: if isAuthorized()
          && request.auth.uid == uid
          && (
            request.method == 'delete'
            || request.resource.data.ownerId == uid
          );
      }
    }

    match /campaigns/{campaignId} {
      allow create: if isAuthorized()
        && request.resource.data.ownerId == request.auth.uid;

      allow read: if isAuthorized()
        && (
          isAdmin()
          || resource.data.ownerId == request.auth.uid
          || isMember(campaignId)
        );

      allow update: if isAuthorized()
        && canManage(campaignId)
        && request.resource.data.ownerId == resource.data.ownerId;

      allow delete: if isAuthorized()
        && (isAdmin() || resource.data.ownerId == request.auth.uid);

      match /shared/{documentId} {
        allow read: if isAuthorized()
          && (canManage(campaignId) || isMember(campaignId));

        allow create, update, delete: if isAuthorized()
          && canManage(campaignId);
      }

      match /private/{documentId} {
        allow read, create, update, delete: if isAuthorized()
          && canManage(campaignId);
      }

      match /adventures/{adventureId} {
        allow read, create, update, delete: if isAuthorized()
          && canManage(campaignId);
      }

      match /characters/{characterId} {
        allow read: if isAuthorized()
          && (
            canManage(campaignId)
            || (
              isMember(campaignId)
              && get(membershipPath(campaignId)).data.characterId == characterId
            )
          );

        allow create, update: if isAuthorized()
          && (
            canManage(campaignId)
            || (
              request.resource.data.ownerUid == request.auth.uid
              && isMember(campaignId)
              && get(membershipPath(campaignId)).data.characterId == characterId
            )
          );

        allow delete: if isAuthorized()
          && (
            canManage(campaignId)
            || resource.data.ownerUid == request.auth.uid
          );
      }
    }

    match /memberships/{memberId} {
      allow read: if isAuthorized()
        && (
          isAdmin()
          || resource.data.uid == request.auth.uid
          || canManage(resource.data.campaignId)
        );

      allow create: if isAuthorized()
        && canManage(request.resource.data.campaignId);

      allow update: if isAuthorized()
        && (
          canManage(resource.data.campaignId)
          || (
            resource.data.uid == request.auth.uid
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.campaignId == resource.data.campaignId
            && request.resource.data.role == resource.data.role
            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['characterId', 'displayName', 'updatedAt'])
          )
        );

      allow delete: if isAuthorized()
        && (
          isAdmin()
          || resource.data.uid == request.auth.uid
          || canManage(resource.data.campaignId)
        );
    }
  }
}
