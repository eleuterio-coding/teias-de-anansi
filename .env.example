# Exemplo SOMENTE para a configuracao publica do SDK Web.
# Copie para .env.local, que esta ignorado pelo Git.
# Obtenha os campos do registro Web do projeto Firebase EXISTENTE, sem criar outro.
# Historico do projeto: projectId "teais-de-anansi" (confirmacao ao vivo pendente).
# Nao insira senhas, service accounts, refresh tokens ou credenciais administrativas.
# Todo VITE_* e PUBLICO no JavaScript compilado. Valores vazios desabilitam a integracao.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Opcionais, se constarem no registro Web existente:
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
