{
  "name": "teias-de-anansi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"*.{json,js,mjs,cjs,ts,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"*.{json,js,mjs,cjs,ts,html}\"",
    "pages:check": "node scripts/verify-pages-build.mjs",
    "verify:boundaries": "node scripts/verify-boundaries.mjs",
    "check": "npm run typecheck && npm run lint && npm run test:run && npm run format:check && npm run verify:boundaries && npm run build && npm run pages:check"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.1",
    "firebase": "13.4.0"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@testing-library/react": "16.1.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "prettier": "3.4.2",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "typescript-eslint": "8.18.0",
    "vite": "6.0.5",
    "vitest": "2.1.8"
  }
}
