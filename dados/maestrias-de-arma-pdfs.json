{
  "modulo": "Maestrias de Arma",
  "gerado_em": "2026-08-19",
  "criterio": "Catálogo centrado na arma/foco: cada item recebe suas propriedades e a Maestria de Arma correspondente. A versão 2024 prevalece quando houver sobreposição.",
  "maestrias_oficiais": [
    {
      "nome": "Cleave",
      "descricao": "Ao acertar uma criatura com um ataque corpo a corpo usando a arma, permite um ataque corpo a corpo adicional contra outra criatura a até 5 pés do primeiro alvo e dentro do alcance da arma. O dano do segundo acerto não recebe o modificador de atributo, salvo se ele for negativo. Uma vez por turno."
    },
    {
      "nome": "Graze",
      "descricao": "Quando a jogada de ataque com a arma erra, causa ao alvo dano do mesmo tipo da arma igual ao modificador de atributo usado na jogada de ataque. Esse dano só aumenta se o modificador de atributo aumentar."
    },
    {
      "nome": "Nick",
      "descricao": "O ataque extra concedido pela propriedade Leve pode ser realizado como parte da ação Atacar, em vez de consumir uma Ação Bônus. Esse ataque extra só pode ser feito uma vez por turno."
    },
    {
      "nome": "Push",
      "descricao": "Ao acertar com a arma, permite empurrar uma criatura Grande ou menor até 10 pés diretamente para longe do atacante."
    },
    {
      "nome": "Sap",
      "descricao": "Ao acertar com a arma, o alvo sofre Desvantagem na próxima jogada de ataque que fizer antes do início do próximo turno do atacante."
    },
    {
      "nome": "Slow",
      "descricao": "Ao acertar e causar dano com a arma, permite reduzir a Velocidade do alvo em 10 pés até o início do próximo turno do atacante. Múltiplos acertos com essa propriedade não ampliam a redução além de 10 pés."
    },
    {
      "nome": "Topple",
      "descricao": "Ao acertar com a arma, permite forçar o alvo a fazer uma salvaguarda de Constituição com CD 8 + modificador de atributo usado no ataque + Bônus de Proficiência. Em falha, o alvo fica Caído."
    },
    {
      "nome": "Vex",
      "descricao": "Ao acertar e causar dano com a arma, concede Vantagem na próxima jogada de ataque contra o mesmo alvo antes do fim do próximo turno do atacante."
    }
  ],
